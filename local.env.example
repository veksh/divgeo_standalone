# Per-machine settings for the solps-grids scripts.
# Copy this file to local.env (ignored by git) and uncomment what you need.
# It is read by bash, so $HOME, $USER, ... work.
#
# Precedence: command-line option > environment variable > local.env > default

# Default device (tokamak) name, at most 12 characters; -d DEVICE overrides it.
# Use the same name on the Mac and on the compute side.
#DEVICE=iter

# --- Mac (DivGeo) -----------------------------------------------------------

# Where bin/build-dg-kit installs DivGeo and where bin/dg finds it.
# Default: .dgkit/ inside this repository.
#DG_KIT=$HOME/opt/divgeo

# DivGeo git repository that bin/build-dg-kit builds from: a local checkout or a URL.
# Default: $SOLPSTOP/modules/DivGeo if it exists, else
# https://github.com/iterorganization/DivGeo.git
#DIVGEO_SRC=$HOME/works/solps/current/SOLPS-ITER/modules/DivGeo

# MacPorts installation prefix. Default: /opt/local
#MACPORTS_PREFIX=/opt/local

# --- Compute side (Linux, SOLPS-ITER) ----------------------------------------

# Root of the Carre work directories: grid-import and grid-export use
# $GRID_WORKDIR/<DEVICE>/<CASE> (or the directory given with -w).
# Default: $SOLPSWORK/grids, i.e. $SOLPSTOP/runs/grids with the stock setup.csh.
#GRID_WORKDIR=/scratch/$USER/solps-grids
